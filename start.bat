@echo off
REM ============================================================
REM start.bat - Servidor de desarrollo local para ABD Bank Manager WebUI
REM ============================================================
REM Deprecado: el servidor de desarrollo YA NO es sirv.
REM Usa Vite (vite dev / vite preview) para la WebUI normal y, si existe,
REM tambien sirve la WebUI embebida del Bank Manager (WebUI/abdbank).

set "ROOT=%~dp0"
cd /d "%ROOT%"

echo ============================================================
echo  ABD Bank Manager - Servidor de desarrollo (Vite)
echo ============================================================

REM ???????????????????????????????????????????????????????????????????
REM 1) Generar artefactos estaticos antes de arrancar Vite.
REM ???????????????????????????????????????????????????????????????????
if not exist "WebUI\src" (
    echo ERROR: No se encuentra WebUI\src
    echo Ejecute primero: build.bat generate
    pause
    exit /b 1
)

call :run node Scripts/registry_generator.js || exit /b 1
call :run node Scripts/build_webui.js || exit /b 1
call :run node Scripts/build_contracts_web.js || exit /b 1
call :run node Scripts/build_core_web.js || exit /b 1
call :run node Scripts/build_contractRegistry_web.js || exit /b 1

REM ???????????????????????????????????????????????????????????????????
REM 2) Preparar assets compartidos para dev sin junctions manuales en tiempo de uso.
REM    build.bat ya crea las junctions/copias necesarias en vendor/.
REM    Aqui solo nos aseguramos de que existen para Vite, sin forzar mklink.
REM ???????????????????????????????????????????????????????????????????
call :ensure_dir "WebUI\vendor\styles"
call :ensure_dir "WebUI\vendor\images"

REM ???????????????????????????????????????????????????????????????????
REM 3) Arrancar Vite en el puerto 1420.
REM    - Vite serve/ dev server para WebUI (http://localhost:1420)
REM    - Tambien sirve un segundo entry para la WebUI embebida del bank manager,
REM      si existe, en la misma instancia (ver vite.config.js).
REM ???????????????????????????????????????????????????????????????????
set PORT=1420

if exist "WebUI\abdbank\index.html" (
    echo.
    echo Servira:
    echo   WebUI principal     http://localhost:%PORT%/
    echo   WebUI embebida      http://localhost:%PORT%/abdbank/
) else (
    echo.
    echo Servira:
    echo   WebUI principal      http://localhost:%PORT%/
    echo   (WebUI embebida      no encontrada: WebUI/abdbank/index.html)
)
echo Presione Ctrl+C para detener.
echo.

node_modules\.bin\vite --config WebUI/vite.config.js --port %PORT%

if %ERRORLEVEL% NEQ 0 (
    echo.
    echo El servidor Vite se ha detenido o no se pudo iniciar.
    pause
)

exit /b 0

:run
%*
if %ERRORLEVEL% NEQ 0 (
    echo ERROR: comando fallo: %*
    pause
    exit /b 1
)
exit /b 0

:ensure_dir
if not exist "%~1" (
    mkdir "%~1" >nul 2>&1 || true
)
exit /b 0