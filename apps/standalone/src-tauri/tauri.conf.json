{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ABD Bank Manager",
  "version": "0.1.0",
  "identifier": "com.abdsynths.bank-manager",
  "build": {
    "beforeDevCommand": "npx vite dev --config ../../../WebUI/vite.config.js",
    "beforeBuildCommand": "cd ../.. && pnpm build:webui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../../dist/webui"
  },
  "app": {
    "windows": [
      {
        "title": "ABD Bank Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' ws: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}