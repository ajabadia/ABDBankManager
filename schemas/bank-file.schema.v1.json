{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ABD Bank Manager Bank File Schema (.abdbank manifest)",
  "schemaVersion": "1.0.0",
  "description": "Schema for the manifest.json inside .abdbank ZIP files. v3: multi-bank library export (banks array) or single bank (bank, retrocompatible v1/v2)",
  "type": "object",
  "required": ["version", "format"],
  "oneOf": [
    {
      "title": "Multi-bank library (v3)",
      "required": ["version", "format", "library", "banks"],
      "properties": {
        "version": { "type": "integer", "const": 3 },
        "format": { "type": "string", "const": "abdbank" },
        "library": {
          "type": "object",
          "required": ["bankCount", "exportedAt"],
          "properties": {
            "bankCount": { "type": "integer", "minimum": 0 },
            "exportedAt": { "type": "string", "format": "date-time" }
          }
        },
        "banks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bank", "patches"],
            "properties": {
              "bank": { "$ref": "#/definitions/bank" },
              "patches": { "$ref": "#/definitions/patches" }
            }
          }
        }
      }
    },
    {
      "title": "Single bank (v1/v2, retrocompatible)",
      "required": ["version", "format", "bank", "patches", "contract"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "format": { "type": "string", "const": "abdbank" },
        "bank": { "$ref": "#/definitions/bank" },
        "patches": { "$ref": "#/definitions/patches" },
        "contract": {
          "type": "object",
          "required": ["modelId", "patchDataSize", "bankCapacity", "banksCount", "programsPerBank"],
          "properties": {
            "modelId": { "type": "string" },
            "patchDataSize": { "type": "integer" },
            "bankCapacity": { "type": "integer" },
            "banksCount": { "type": "integer" },
            "programsPerBank": { "type": "integer" }
          }
        }
      }
    }
  ],
  "definitions": {
    "bank": {
      "type": "object",
      "required": ["id", "name", "modelId", "manufacturer", "isFactory", "creationDate", "patchCount"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "maxLength": 64 },
        "modelId": { "type": "string" },
        "manufacturer": { "type": "string" },
        "isFactory": { "type": "boolean" },
        "isLocked": { "type": "boolean", "default": false },
        "creationDate": { "type": "string", "format": "date-time" },
        "modifiedDate": { "type": "string", "format": "date-time" },
        "patchCount": { "type": "integer", "minimum": 0 },
        "source": { "type": ["string", "null"], "description": "Original file path/URL" }
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "name", "address", "category", "author", "tags", "isFavorite", "rating", "rawDataFile", "parameters"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "maxLength": 64 },
          "address": { "type": "string" },
          "category": { "type": "string" },
          "author": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string", "default": "" },
          "isFavorite": { "type": "boolean" },
          "rating": { "type": "integer", "minimum": 0, "maximum": 5 },
          "rawDataFile": { "type": "string", "description": "Relative path (patches/ o banks/NN/)" },
          "parameters": { "type": "object", "additionalProperties": { "type": "number" } },
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of sound bytes" },
          "versionNumber": { "type": "integer", "minimum": 1, "default": 1 },
          "previousVersionId": { "type": ["string", "null"], "format": "uuid" }
        }
      }
    }
  }
}
