{
  "name": "@abdsynths/bank-manager",
  "version": "0.1.0",
  "description": "Universal patch & bank management library for ABDSynths projects",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node Scripts/registry_generator.js && node Scripts/build_contracts_web.js && node Scripts/build_core_web.js && node Scripts/build_contractRegistry_web.js && node Scripts/build_webui.js",
    "catalog:dm12": "node Scripts/catalog_dm12_sysex.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:webui": "vite build --config WebUI/vite.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sync-contracts": "node scripts/sync_contracts.mjs",
    "verificar:entorno": "node scripts/verificar-entorno.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "zod": "^3.22.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.25.0"
}
